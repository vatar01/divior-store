rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Почта администратора. Должна совпадать с ADMIN_EMAIL в index.html.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'ryabovdima112@gmail.com';
    }
    function signedIn() { return request.auth != null; }

    // Каталог (пачками по 300 товаров) и фото товаров видят все, менять может только администратор.
    match /catalog/{chunk} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /specs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Вопросы в поддержку: оставить может любой посетитель, читает и обрабатывает только администратор.
    match /messages/{id} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 2
        && request.resource.data.text.size() <= 1500
        && request.resource.data.keys().hasOnly(['name','phone','text','at','status','email','uid']);
      allow read, update, delete: if isAdmin();
    }
    // Чат поддержки. Покупатель знает только id своего чата (случайный, 24 символа).
    match /chats/{cid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['last','lastFrom','at','unread','name','phone','uid','email'])
        && request.resource.data.lastFrom == 'client';
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','lastFrom','at','unread','name','phone'])
            && request.resource.data.lastFrom == 'client');
      allow delete: if isAdmin();
      match /msgs/{mid} {
        allow read: if true;
        allow create: if (request.resource.data.from == 'client'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500
            && request.resource.data.keys().hasOnly(['from','text','at']))
          || (isAdmin() && request.resource.data.from == 'admin');
        allow delete: if isAdmin();
      }
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Профиль покупателя: свой видит и меняет сам покупатель, все профили видит администратор.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Заказы создаёт только сервер (функция order): он сам считает цены и списывает остатки.
    // Покупатель видит только свои заказы; статус меняет администратор (через сервер или бота).
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }
    // Служебные счётчики защиты от спама — только для сервера.
    match /limits/{id} {
      allow read, write: if false;
    }
  }
}
