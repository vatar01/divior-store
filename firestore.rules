rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Почта администратора. Должна совпадать с ADMIN_EMAIL в index.html.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'ryabovdima112@gmail.com';
    }
    function signedIn() { return request.auth != null; }

    // Каталог (пачками по 300 товаров) и фото товаров видят все, менять может только администратор.
    match /catalog/{chunk} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /specs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Вопросы в поддержку: оставить может любой посетитель, читает и обрабатывает только администратор.
    match /messages/{id} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 2
        && request.resource.data.text.size() <= 1500
        && request.resource.data.keys().hasOnly(['name','phone','text','at','status','email','uid']);
      allow read, update, delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Профиль покупателя: свой видит и меняет сам покупатель, все профили видит администратор.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Заказы: покупатель создаёт свой заказ и видит только свои, статус меняет администратор.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      allow update, delete: if isAdmin();
    }
  }
}
